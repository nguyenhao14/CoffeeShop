<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
	<appSettings>
		<!-- Thay bằng base URL của Web API -->
		<add key="ApiBaseUrl" value="http://localhost:5000/api/" />
	</appSettings>
</configuration>